# RESORIXtrack configuration. Copy to .env, chmod 600 .env. Reference: docs/installation.md#environment-reference
# Secrets can also be read from files (Docker/Compose secrets): SECRET_KEY_FILE, SIGNOFF_KEY_FILE,
# BACKUP_PASSWORD_FILE, SMTP_PASSWORD_FILE, OIDC_CLIENT_SECRET_FILE (the file wins over the variable).

# ---------------------------------------------------------------- required
# Random, at least 32 characters: openssl rand -base64 48. The app refuses the placeholder or a weak key.
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Encrypts every backup (at least 12 characters). Keep it in your password manager: without it no backup can be
# restored. Changing it affects new backups only.
BACKUP_PASSWORD=change-me-to-a-backup-passphrase
# Public URL as typed in the browser (emails, cookies, passkeys, single sign-on)
BASE_URL=https://time.example.com

# ---------------------------------------------------------------- email (SMTP)
# Mail server; empty disables email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=resorixtrack@example.com
SMTP_PASSWORD=
# Sender address
MAIL_FROM=RESORIXtrack <resorixtrack@example.com>
# true: allow sending the password over SMTP_SECURITY=none (trusted local relay only)
# SMTP_ALLOW_PLAINTEXT_AUTH=false
# Seconds before a connection attempt gives up
# SMTP_TIMEOUT=20

# ---------------------------------------------------------------- web / proxy
# Domain for the built-in Caddy TLS proxy (docker compose --profile tls up -d)
RESORIXTRACK_DOMAIN=time.example.com
# Reverse proxies in front of the app: 1 for Caddy or your own proxy, 0 when browsers reach the app directly
TRUSTED_PROXIES=1
# Cookies over HTTPS only. false ONLY for a plain-HTTP test on a trusted network.
SESSION_COOKIE_SECURE=true
# Published host port and bind address of the app. Keep 127.0.0.1 unless you want plain HTTP on the network.
RESORIXTRACK_PORT=8080
RESORIXTRACK_BIND=127.0.0.1

# ---------------------------------------------------------------- single sign-on (OpenID Connect, optional)
# Redirect URI at the provider: <BASE_URL>/api/auth/callback/oidc. Only existing active people can sign in.
# Issuer URL; single sign-on is on when issuer and client id are set
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Button label
# OIDC_NAME=Pocket ID
# OIDC_SCOPES=openid email profile
# true: no password sign-in (break-glass: rt reset-password)
# OIDC_ONLY=false
# false: also match emails the provider has not verified
# OIDC_REQUIRE_VERIFIED_EMAIL=true

# ---------------------------------------------------------------- security (optional)
# Key for sign-off seals (default SECRET_KEY). Keep it apart from your backups. After a v1 import: v1's key.
# SIGNOFF_KEY=
# Session lifetime with "keep me signed in"
# SESSION_REMEMBER_DAYS=30
# Idle timeout without "keep me signed in"
# SESSION_SHORT_IDLE_HOURS=12
# Hard cap for any session, however active
# SESSION_ABSOLUTE_DAYS=90
# Failed sign-ins per email and IP before throttling
# LOGIN_MAX_FAILURES=8
# Throttling window
# LOGIN_WINDOW_MINUTES=15
# Ask for the one-time setup code in the setup wizard
# SETUP_CODE_REQUIRED=true
# Reject passwords found in Have I Been Pwned (sends a 5-character hash prefix only)
# PWNED_PASSWORDS_CHECK=true

# ---------------------------------------------------------------- application (optional)
# Largest document upload
# ATTACHMENT_MAX_MB=10
# Nightly automatic backups to keep
# BACKUP_KEEP=14
# "Source code" link on the sign-in page; point it to your fork if you modified RESORIXtrack (AGPL section 13)
# SOURCE_URL=https://github.com/RESORIX-AG/RESORIXtrack
# Data directory and database file inside the container (set by the image)
# RESORIXTRACK_DATA_DIR=/data
# DATABASE_PATH=/data/resorixtrack.db

# ---------------------------------------------------------------- Docker Compose (optional)
# Image to run
# RESORIXTRACK_IMAGE=resorixtrack:latest
# Memory limits of app and worker
# RESORIXTRACK_MEM_LIMIT=1g
# RESORIXTRACK_WORKER_MEM_LIMIT=512m
# With docker-compose.proxy.yml: Docker network of your reverse proxy, and the container port it points at
# PROXY_NETWORK=proxy
# PORT=8080
