# ---------------------------------------------------------------- required
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the placeholder below or with a short / low-entropy key.
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Every backup is encrypted with this password (at least 12 characters; the app refuses to start without it).
# Keep it in your password manager: without it no backup can be restored. Changing it affects new backups only.
BACKUP_PASSWORD=change-me-to-a-backup-passphrase
# Public URL of your installation (used in invitation and password reset emails)
BASE_URL=https://time.example.com

# ---------------------------------------------------------------- email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls | ssl | none   (a password is never sent over "none" unless SMTP_ALLOW_PLAINTEXT_AUTH=true)
SMTP_SECURITY=starttls
SMTP_USER=resorixtrack@example.com
SMTP_PASSWORD=
MAIL_FROM=RESORIXtrack <resorixtrack@example.com>

# ---------------------------------------------------------------- web / proxy
# Domain for the built-in Caddy TLS proxy (docker compose --profile tls up -d)
RESORIXTRACK_DOMAIN=time.example.com
# Number of reverse proxies in front of the app: 1 for the built-in Caddy or your own proxy,
# 0 when browsers reach the app directly. Forwarded headers are only trusted when >= 1.
TRUSTED_PROXIES=1
# Cookies are only sent over HTTPS. Set to false ONLY for a plain-HTTP test setup on a trusted network.
SESSION_COOKIE_SECURE=true
# Host port and bind address of the app. Keep 127.0.0.1 unless you really want plain HTTP on the network.
RESORIXTRACK_PORT=8080
RESORIXTRACK_BIND=127.0.0.1

# ---------------------------------------------------------------- optional
# Separate key for sealing month sign-offs (defaults to SECRET_KEY). Recommended: keep it in a
# different place than your backups so a stolen backup can't forge seals.
# SIGNOFF_KEY=
# Secrets can also be read from files (Docker/Compose secrets): SECRET_KEY_FILE, SIGNOFF_KEY_FILE, BACKUP_PASSWORD_FILE, SMTP_PASSWORD_FILE
# SESSION_SHORT_IDLE_HOURS=12      # idle timeout when "keep me signed in" is off
# SESSION_ABSOLUTE_DAYS=90         # hard cap for any session, however often it is used
# LOGIN_MAX_FAILURES=8             # per email+IP within LOGIN_WINDOW_MINUTES
# ATTACHMENT_MAX_MB=10
# BACKUP_KEEP=14                   # nightly automatic backups to keep
# SOURCE_URL=https://github.com/RESORIX-AG/RESORIXtrack   # "Source code" link on the sign-in page; defaults to the upstream repository.
#                                                      # Point it to your fork if you modified RESORIXtrack (AGPL section 13).
# RESORIXTRACK_MEM_LIMIT=1g           # container memory limits (app / worker)
# PROXY_NETWORK=proxy                # with docker-compose.proxy.yml: the Docker network your reverse proxy is on
# PORT=8080                          # with docker-compose.proxy.yml: container port the proxy entry points at
# RESORIXTRACK_WORKER_MEM_LIMIT=512m
# WEB_WORKERS=2
# WEB_THREADS=4
# LOG_LEVEL=info
