# Automatic HTTPS (Let's Encrypt) for RESORIXtrack. Set RESORIXTRACK_DOMAIN in .env.
{
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

{$RESORIXTRACK_DOMAIN:localhost} {
	encode zstd gzip
	# The app sets its own security headers; Caddy adds HSTS and hides its version.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 12MB
	}
	reverse_proxy app:8080 {
		header_up X-Forwarded-Proto https
	}
}
